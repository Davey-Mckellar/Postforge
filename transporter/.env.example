# Neon Postgres URL for the Transporter database.
# Use a separate database from bbGPT; do NOT point at bbGPT's DATABASE_URL.
DATABASE_URL=postgres://user:password@ep-xxx.neon.tech/transporter?sslmode=require

# Auth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-random-32-bytes
AUTH_URL=http://localhost:3100
